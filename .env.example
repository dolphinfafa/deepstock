# IBKR TWS API connection. Keep any sensitive values only in the untracked .env.
# Verify the paper-mode socket port in TWS or IB Gateway before setting it here.
IBKR_MODE=paper
IBKR_HOST=127.0.0.1
IBKR_PORT=
IBKR_CLIENT_ID=
IBKR_ACCOUNT=

# Hash the account locally as sha256("salt:account") and pin the result here.
IBKR_ACCOUNT_HASH_SALT=
IBKR_EXPECTED_ACCOUNT_HASH=

# Must remain true until read-only tests, reconciliation, and paper-order tests pass.
IBKR_READ_ONLY=true
IBKR_LIVE_EXECUTION_ENABLED=false
IBKR_LIVE_CONFIRMATION=
IBKR_LOCAL_NOTIONAL_CAP_USD=1000
IBKR_MAX_DATA_AGE_DAYS=3
IBKR_ALLOW_NONSTANDARD_PORT=false
IBKR_AGENT_STATE_PATH=artifacts/ibkr_agent/execution_state.json

# Massive is the primary research-data source. Keep the actual key local.
MASSIVE_API_KEY=

# Deepstock web application. Runtime secrets belong only in the local .env.
DEEPSTOCK_DATABASE_URL=sqlite:///artifacts/app/deepstock.sqlite3
DEEPSTOCK_SESSION_COOKIE=deepstock_session
DEEPSTOCK_SESSION_HOURS=12
DEEPSTOCK_BOOTSTRAP_USERNAME=admin
DEEPSTOCK_BOOTSTRAP_PASSWORD=admin
DEEPSTOCK_NODE_TOKEN=
DEEPSTOCK_API_BASE_URL=https://dev-cn-01.yios.cn/deepstock/api
DEEPSTOCK_PUBLIC_BASE_URL=https://dev-cn-01.yios.cn/deepstock

# Live trading is fail-closed. Both values must be changed locally after review.
DEEPSTOCK_LIVE_TRADING_ENABLED=false
DEEPSTOCK_LIVE_NOTIONAL_CAP_USD=1000
DEEPSTOCK_GLOBAL_KILL_SWITCH=true

# Severe execution and system alerts are sent to this enterprise-WeChat webhook.
WECHAT_WEBHOOK_URL=
